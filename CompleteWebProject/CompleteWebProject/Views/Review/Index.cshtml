@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Project.Models.Domains
@model ViewLists
@{
    bool flag = false;
}
<head>
    <title>Reviews</title>
</head>

    <div class="container-fluid p-5 justify-content-center text-center review-container">
        <h1 class="catalog-heading">What Clients Say!</h1>
        <p class="text-white">Home  | Reviews</p>
    </div>

    <div class="container mt-5 text-black">
        <h2 class="mb-4">Customer Reviews</h2>
        <div class="row justify-content-center">
            @foreach(var review in @Model.reviewList)
            {
            flag = true;
            var user = Model.userList.FirstOrDefault(u => u.Id == @review.userId);

                <div class="col-md-6">
                    <div class="review-card d-flex flex-column align-items-center p-3 border rounded">
                        <img src="@user.imageUrl" alt="Amazing Car" width="100" class="mb-3 rounded-circle">
                        <div class="justify-content-center text-center">
                            <h4 class="review-title">@review.title</h4>
                            <p>
                                @review.content
                            </p>
                            <small class="d-flex align-items-center">
                                <i class="fas fa-user"></i> @($"{user.firstName} {user.lastName}")
                            </small>
                            <div class="stars mt-2">
                                @for(int i = 0; i < @review.rating; i++)
                                {
                                   <i class="fas fa-star"></i>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        @if (!flag)
        {
            <h4 class="text-center text-black">No Reviews Yet!</h4>
        }
    </div>
        <div class="mt-2 mb-5 justify-content-center text-center">
            <a href="@Url.Action("AddReview","Review")">
                <button class="show-button px-sm-4 py-sm-2">
                    Submit a Review
                </button>
            </a>
        </div>
    </div>
