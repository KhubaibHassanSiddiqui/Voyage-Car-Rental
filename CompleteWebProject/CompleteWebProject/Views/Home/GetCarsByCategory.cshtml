@using Project.Models.Domains
@model List<Car>
@{
    var placeholders = new List<string>
{
    "Experience the thrill of the open road in an unparalleled style.",
    "Drive your dreams with unmatched elegance and power.",
    "Unleash the beast on every journey with precision and speed.",
    "Redefine luxury and performance with every mile you travel.",
    "Crafted for those who settle for nothing but the best.",
    "Feel the adrenaline rush with every turn and every ride."
};
}

@if (@Model.Count > 0 && Model.Count(c => c.isAvailable == 1) > 0)
{
    <div class="row justify-content-center">
        @for (int i = 0; i < @Model.Count && i < 3; i++)
        {
            @if (@Model[i].isAvailable == 1)
            {
                <div class="col-md-4 col-sm-12 d-flex justify-content-center mb-4">
                    <a href="@Url.Action("Book","Booking",new{carid=Model[i].Id})">
                        <div class="card card-custom">
                            <img src="@Model[i].imageUrl" class="card-img-top" alt="Car Image" width="55">
                            <div class="card-body">
                                <h5 class="card-title fw-bold">@($"{Model[i].make} {Model[i].model}")</h5>
                                <p class="card-text">@placeholders[i]</p>
                                <div class="d-flex justify-content-center mb-2">
                                    <span class="me-3"><i class="fas fa-cog"></i>@Model[i].category</span>
                                    <span class="me-3"><i class="fas fa-gas-pump"></i>@Model[i].fuelType</span>
                                    <span><i class="fas fa-hourglass-half"></i>@Model[i].year</span>
                                </div>
                            </div>
                            <div class="card-footer d-flex justify-content-between align-items-center">
                                <div class="stars">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                </div>
                                <div class="price">
                                    Price : @($"$ {Model[i].pricePerDay}/Day")
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
    </div>
}
@if (@Model.Count > 3)
{
    <div class="row justify-content-center">
        @for (int i = 3; i < @Model.Count && i < 6; i++)
        {
            @if (@Model[i].isAvailable == 1)
            {
                <div class="col-md-4 col-sm-12 d-flex justify-content-center mb-4">
                    <a href="@Url.Action("Book","Booking",new{carid=Model[i].Id})">
                        <div class="card card-custom">
                            <img src="@Model[i].imageUrl" class="card-img-top" alt="Car Image" width="55">
                            <div class="card-body">
                                <h5 class="card-title fw-bold">@($"{Model[i].make} {Model[i].model}")</h5>
                                <p class="card-text">@placeholders[i]</p>
                                <div class="d-flex justify-content-center mb-2">
                                    <span class="me-3"><i class="fas fa-cog"></i>@Model[i].category</span>
                                    <span class="me-3"><i class="fas fa-gas-pump"></i>@Model[i].fuelType</span>
                                    <span><i class="fas fa-hourglass-half"></i>@Model[i].year</span>
                                </div>
                            </div>
                            <div class="card-footer d-flex justify-content-between align-items-center">
                                <div class="stars">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                </div>
                                <div class="price">
                                    Price : @($"$ {Model[i].pricePerDay}/Day")
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
    </div>
}
<div class="mt-2">
    <a href="@Url.Action("Index","Booking")">
        <button class="show-button px-sm-4 py-sm-2">
            SHOW ALL CARS
        </button>
    </a>
</div>