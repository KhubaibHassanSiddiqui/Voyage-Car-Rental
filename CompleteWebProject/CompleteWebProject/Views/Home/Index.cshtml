        <h2>Contact Us</h2>
        <p class="text-white">We'd love to hear from you. Whether you have a question or need assistance, feel free to reach out.</p>
        <p class="phone-number text-white">Call now: +92 90078601</p>
        <a href="tel:+9290078601" target="_blank" class="btn-contact">CONTACT US</a>
    </div>
</div>

@if (Model.reviewList.Count > 0)
{
    <div class="testimonial-section mb-2">
        <h2 class="text-dark">What Clients Say</h2>
        <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="testimonial">
                        <p>@($"{Model.reviewList[0].title}")</p>
                        <p>@($"\"{Model.reviewList[0].content}\"")</p>
                        @{
                            var user = Model.userList.FirstOrDefault(u => u.Id == Model.reviewList[0].userId);
                        }
                        @if (user != null)
                        {
                            <img src="@user.imageUrl" alt="Client">
                            <div class="client-name">@($"{user.firstName} {user.lastName}")</div>
                            <div class="stars mt-2">
                                @for (int i = 0; i < Model.reviewList[0].rating; i++)
                                {
                                    <i class="fas fa-star"></i>
                                }
                            </div>
                        }
                    </div>
                </div>
                @for(int i=1;i<Model.reviewList.Count;i++)
                {
                    <div class="carousel-item">
                        <div class="testimonial">
                            <p>@($"{Model.reviewList[i].title}")</p>
                            <p>@($"\"{Model.reviewList[i].content}\"")</p>
                            @{
                                user = Model.userList.FirstOrDefault(u => u.Id == Model.reviewList[i].userId);
                            }
                            @if (user != null)
                            {
                                <img src="@user.imageUrl" alt="Client">
                                <div class="client-name">@($"{user.firstName} {user.lastName}")</div>
                                <div class="stars mt-2">
                                    @for (int j = 0; j < Model.reviewList[i].rating; j++)
                                    {
                                        <i class="fas fa-star"></i>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>
}

<script>
    function loadPartialView(category) {
        console.log("Button clicked with category:", category);
        var sortOption = category;
        var carList = @Html.Raw(Json.Serialize(Model.carList));
        var data = {
            sortOrder: sortOption,
            cars: carList
        };

        $.ajax({
            type: 'POST',
            url: '@Url.Action("GetCarsByCategory", "Home")',
            data: JSON.stringify(data),
            contentType: 'application/json; charset=utf-8',
            success: function (result) {
                $('#carCategory').html(result);
            },
            error: function (xhr, status, error) {
                console.log('Error occurred:', xhr.responseText);
            }
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        let counters = document.querySelectorAll('.counter');
        let statsSection = document.querySelector('.stats-section');
        let started = false;

        function startCounter(counter) {
            let target = +counter.getAttribute('data-target');
            let count = 0;
            let increment = target / 200;

            let updateCounter = setInterval(function () {
                count += increment;
                counter.textContent = Math.ceil(count);

                if (count >= target) {
                    clearInterval(updateCounter);
                    counter.textContent = target;
                }
            }, 10);
        }

        window.addEventListener('scroll', function () {
            let statsPosition = statsSection.getBoundingClientRect().top;
            let screenPosition = window.innerHeight / 1.2;

            if (statsPosition < screenPosition && !started) {
                started = true;
                counters.forEach(counter => {
                    startCounter(counter);
                });
            }
        });
    });

</script>