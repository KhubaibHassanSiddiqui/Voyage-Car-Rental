@if (Model.carList.Count > 0 && Model.carList.Count(c => c.isAvailable == 1) > 0)
{
    var car = Model.carList.FirstOrDefault(car => car.isAvailable == 1);
    <div class="carousel-container mb-2">
        <div class="row justify-content-center">
            <div class="col-12 d-flex justify-content-center align-items-center mb-2">
                <span class="line2"></span>
                <span class="line mx-1"></span>
                <span class="line2"></span>
            </div>
            <div class="col-12 col-lg-10">
                <div id="carSlider" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
                    <div class="carousel-inner">
                        @if (car.isAvailable == 1)
                        {
                            <a class="why-car" href="@Url.Action("Book","Booking",new{carid=Model.carList[0].Id})">
                                <div class="carousel-item active">
                                    <img src="@car.imageUrl" alt="Car">
                                    <div class="carousel-caption mt-5">
                                        <span class="badge badge-car">@($"$ {car.pricePerDay}/Day")</span>
                                        <h5>@($"{car.year} {car.make} {car.model}")</h5>
                                    </div>
                                </div>
                            </a>
                        }
                        @for (int i = 1; i < Model.carList.Count; i++)
                        {
                            @if (Model.carList[i] != car)
                            {
                                if (Model.carList[i].isAvailable == 1)
                                {
                                    <a class="why-car" href="@Url.Action("Book","Booking",new{carid=Model.carList[i].Id})">
                                        <div class="carousel-item">
                                            <img src="@Model.carList[i].imageUrl" alt="Car">
                                            <div class="carousel-caption mt-5">
                                                <span class="badge badge-car">@($"$ {Model.carList[i].pricePerDay}/Day")</span>
                                                <h5>@($"{Model.carList[i].year} {Model.carList[i].make} {Model.carList[i].model}")</h5>
                                            </div>
                                        </div>
                                    </a>
                                }
                            }
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carSlider" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carSlider" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

