<head>
    <title>HomePage</title>
</head>
    <div class="full-width-container p-2 head-container">

        <div class="row pt-2">
            <div class="col-6">
                <div class="heading-2">
                    TAKE A TEST DRIVE
                </div>
                <div class="sub-text mb-4">
                    Rev up your journey with our exceptional selection of cars, where every drive transforms into an unforgettable adventure, and each road becomes a thrilling exploration of freedom and excitement.
                </div>
                <div class="mt-4">
                    <a href="@Url.Action("Index","Booking")">
                        <button class="book-button px-sm-4 py-sm-1">
                            BOOK A CAR
                        </button>
                    </a>
                </div>
            </div>
            <div class="news-tags col-4 offset-2 justify-content-center text-center">
                @for(int i = 0; i < @Model.carList.Count && i<3; i++)
                {
                    @if (@Model.carList[i].isAvailable == 1)
                    {
                        <div class="mb-4">
                            <a class="icon-link icon-link-hover" href="@Url.Action("Book","Booking",new{carid=Model.carList[i].Id})">
                                @($"{Model.carList[i].year} {Model.carList[i].make} {Model.carList[i].model}")
                            </a>
                        </div>
                    }
                }

            </div>
        </div>

        <div class="container my-2 w-80 justify-content-center">
            <div class="row justify-content-center">
                <div class="col-md-8 text-center">
                    <div class="d-flex align-items-center justify-content-center">
                        <span class="line"></span>
                        <h1 class="heading-2 d-inline-block mx-3">FIND THE RIGHT CAR FOR EVERY OCCASION</h1>
                        <span class="line"></span>
                    </div>
                </div>
            <form class="row g-3 text-whi" method="post" asp-action="Index">
                <div class="col-md-6">
                    <label for="pickUpLocation" class="form-label text-white">Pick Up Location</label>
                    <input type="text" class="form-control" id="pickup" placeholder="City, State or Airport Code" name="booking.pickup" required>
                </div>
                <div class="col-md-3">
                    <label for="pickUpDate" class="form-label text-white">Pick Up Date</label>
                    <input type="date" class="form-control" id="startDate" name="booking.startDate" required>
                </div>
                <div class="col-md-3">
                    <label for="pickUpTime" class="form-label text-white">Time</label>
                    <input type="time" class="form-control" id="startTime" name="booking.startTime" required>
                </div>
                <div class="col-md-6">
                    <label for="returnLocation" class="form-label text-white">Return to a different location</label>
                    <input type="text" class="form-control" id="dropoff" name="booking.dropoff" placeholder="City, State or Airport Code" required>
                </div>
                <div class="col-md-3">
                    <label for="returnDate" class="form-label text-white">Return Date</label>
                    <input type="date" class="form-control" id="endDate" name="booking.endDate" required>
                </div>
                <div class="col-md-3">
                    <label for="returnTime" class="form-label text-white">Time</label>
                    <input type="time" class="form-control" id="endTime" name="booking.endTime" required>
                </div>
                <hr class="m-0">

                <div class="col-12 d-flex justify-content-center mt-4">
                    <button type="submit" class="book-button px-sm-4 py-sm-1">BOOK A CAR</button>
                </div>
            </form>


            </div>

        </div>

    </div>
    </div>

    <div class="container-fluid p-5 text-center">
        <span class="line"></span>
        <h1 class="d-inline-block text-black">Featured Vehicles</h1>
        <span class="line"></span>
        <p class="sub-text">
            Book your favourite car right now and live your life a quarter mile at a time!
        </p>
    @if (@Model.carList.Count > 0 && @Model.carList.Count(c => c.isAvailable == 1) > 0)
            {
                <div class="row justify-content-center featured-container my-4">
            <div class="col-3">
                <div class="mt-4">
                    <button class="featured-button px-sm-4 py-sm-1" onclick="loadPartialView('All')">
                        All
                    </button>
                </div>
            </div>
            <div class="col-3">
                <div class="mt-4">
                    <button class="featured-button px-sm-4 py-sm-1" onclick="loadPartialView('Luxury')">
                        Luxury
                    </button>
                </div>
            </div>
            <div class="col-3">
                <div class="mt-4">
                    <button class="featured-button px-sm-4 py-sm-1" onclick="loadPartialView('Sedan')">
                        Sedan
                    </button>
                </div>
            </div>
        </div>
            }
        <div class="container mt-5" id="carCategory">
        @await Html.PartialAsync("GetCarsByCategory",Model.carList)
        </div>

    </div>

<section class="stats-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 mb-4">
                <span class="highlight-bar">
                    <span class="dot"></span> FIND YOUR PERFECT CAR <span class="dot"></span>
                </span>
            </div>
            <div class="col-md-3 col-sm-6 stats-item">
                <img src="img/sedan.png" alt="Cars">
                <h3><span class="counter" data-target="@Model.carList.Count">0</span>+</h3>
                <p class="text-white">Cars In Stock</p>
            </div>
            <div class="col-md-3 col-sm-6 stats-item">
                <img src="img/car.png" alt="Bookings">
                <h3><span class="counter" data-target="@Model.bookList.Count">0</span>+</h3>
                <p class="text-white">Bookings Made</p>
            </div>
            <div class="col-md-3 col-sm-6 stats-item">
                <img src="img/maintenance.png" alt="Bookings Completed">
                <h3><span class="counter" data-target="@Model.paymentList.Count">0</span>+</h3>
                <p class="text-white">Bookings Completed</p>
            </div>
            <div class="col-md-3 col-sm-6 stats-item">
                <img src="img/rocket.png" alt="Happy Clients">
                <h3><span class="counter" data-target="@Model.userList.Count">0</span>+</h3>
                <p class="text-white">Happy Clients</p>
            </div>
        </div>
    </div>
</section>

