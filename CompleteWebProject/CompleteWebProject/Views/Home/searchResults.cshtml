@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Project.Models.Domains
@model List<Car>

@{
    bool flag = false;
    var userId = HttpContextAccessor.HttpContext.Session.GetString("UserId");
}

<div class="container">
    <div class="row mt-4">
        <div class="col-lg-12">
            <div class="d-flex justify-content-between align-items-center mb-3 text-black">
                <h5>Total Cars Found : <span class="text-warning">@Model.Count(car => car.isAvailable == 1)</span></h5>
            </div>
            @if (Model.Count > 0)
            {
                <div class="row">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        @if (Model[i].isAvailable == 1)
                        {
                            flag = true;
                            <div class="col-md-6 mb-4">
                                <div class="card car-card">
                                    <div class="row g-0">
                                        <div class="col-md-5 col-12">
                                            <img src="@Model[i].imageUrl" class="card-img-top" alt="Car Image" width="100">
                                        </div>
                                        <div class="col-md-7">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <span class="badge badge-new-car">For Rent</span>
                                                    </div>
                                                    <div class="price-tag">@($"$ {Model[i].pricePerDay}/Day")</div>
                                                </div>
                                                <h5 class="card-title mt-3">@($"{Model[i].make} {Model[i].model}")</h5>
                                                <p class="text-muted"><i class="bi bi-geo-alt"></i> 71 - Wast San Park St, New York, NY 98517</p>
                                                <a href="@Url.Action("Book", "Booking", new { carid = Model[i].Id })">
                                                    <button type="submit" class="btn btn-outline-warning btn-sm">Book Now</button>
                                                </a>
                                                <div class="mt-3">
                                                    <small>Model: @Model[i].year  •  Category: @Model[i].fuelType  •  Fuel: @Model[i].fuelType</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            @if (!flag)
            {
                <h4 class="text-center text-black mt-3 mb-4">No Results</h4>
            }
        </div>
    </div>
</div>
