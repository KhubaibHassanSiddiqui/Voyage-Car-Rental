@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Project.Models.Domains

<head>
    <title>About Us</title>
</head>

<div class="container-fluid p-5 justify-content-center text-center about-container">
    <h1 class="catalog-heading">ABOUT US</h1>
    <p class="text-white">Home | About Us</p>
</div>
<div class="text-center mt-5">
    <span class="line"></span>
    <h1 class="d-inline-block text-black">ABOUT VOYAGE RENTALS</h1>
    <span class="line"></span>
</div>
<section class="about-section text-center mb-3">
    <div class="container">
        <p class="about-text text-black">
            Welcome to Voyage Car Rental, your trusted partner for luxury car rentals. Our mission is to provide you
            with the best car rental experience by offering a wide range of premium vehicles tailored to your needs.
            Whether you're looking for a stylish sedan, a spacious SUV, or a luxurious ride, we've got you covered.
        </p>
    </div>
</section>

<!-- FAQ Section -->
<section class="container my-5">
    <h2 class="text-center mb-4 text-black">Frequently Asked Questions</h2>
    <div class="accordion" id="faqAccordion">
        <div class="accordion-item">
            <h2 class="accordion-header" id="faqHeadingOne">
                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faqCollapseOne" aria-expanded="true" aria-controls="faqCollapseOne">
                    What documents do I need to rent a car?
                </button>
            </h2>
            <div id="faqCollapseOne" class="accordion-collapse collapse show" aria-labelledby="faqHeadingOne"
                 data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    You will need a valid driver's license, a credit card in your name, and proof of insurance.
                    International renters may also need a valid passport.
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header" id="faqHeadingTwo">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faqCollapseTwo" aria-expanded="false" aria-controls="faqCollapseTwo">
                    Can I return the car to a different location?
                </button>
            </h2>
            <div id="faqCollapseTwo" class="accordion-collapse collapse" aria-labelledby="faqHeadingTwo"
                 data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    Yes, we offer one-way rentals with the option to return the car to a different location.
                    Additional fees may apply.
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header" id="faqHeadingThree">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faqCollapseThree" aria-expanded="false" aria-controls="faqCollapseThree">
                    What is your fuel policy?
                </button>
            </h2>
            <div id="faqCollapseThree" class="accordion-collapse collapse" aria-labelledby="faqHeadingThree"
                 data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    We provide the car with a full tank of fuel, and we ask that you return it with a full tank. If
                    you don't, we will refuel it for you, and additional charges will apply.
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header" id="faqHeadingFour">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faqCollapseFour" aria-expanded="false" aria-controls="faqCollapseFour">
                    Do you offer insurance coverage?
                </button>
            </h2>
            <div id="faqCollapseFour" class="accordion-collapse collapse" aria-labelledby="faqHeadingFour"
                 data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    Yes, we offer a range of insurance options to suit your needs. Please inquire at the time of
                    booking for more details.
                </div>
            </div>
        </div>
    </div>
</section>