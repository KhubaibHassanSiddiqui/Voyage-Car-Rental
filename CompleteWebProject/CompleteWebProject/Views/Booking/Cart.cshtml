@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Project.Models.Domains
@model ViewLists
@{
    bool flag = false;
    var userId = HttpContextAccessor.HttpContext.Session.GetString("UserId");
    float pp = 0.0f;
}

<head>
    <title>Shopping Cart</title>
</head>

<div class="container-fluid p-5 justify-content-center text-center cart-container">
    <h1 class="catalog-heading">Your Cart</h1>
    <p class="text-white">Home | Cart</p>
</div>

<div class="container">
    <div class="row mt-4">
        <div class="col-lg-8">
            @if (@Model.bookList.Count > 0)
            {
                @for (int i = 0; i < @Model.bookList.Count; i++)
                {
                    pp += Model.bookList[i].totalPrice;
                    var car = Model.carList.FirstOrDefault(c => c.Id == Model.bookList[i].carId);
                    flag = true;
                    <div class="card car-card">
                        <div class="row g-0">
                            <div class="col-md-5 col-12">
                                <img src="@car.imageUrl" class="card-img-top" alt="Car Image" width="100">
                            </div>
                            <div class="col-md-7">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge badge-new-car">For Rent</span>
                                        </div>
                                        <div class="price-tag">@($"${Model.bookList[i].totalPrice}")</div>
                                    </div>
                                    <h5 class="card-title mt-3">@($"{car.make} {car.model}")</h5>
                                    <p class="text-muted"><i class="bi bi-geo-alt"></i>Pickup: @($"{Model.bookList[i].pickup} {Model.bookList[i].startDate}")</p>
                                    <p class="text-muted"><i class="bi bi-geo-alt"></i>Dropoff: @($"{Model.bookList[i].dropoff} {Model.bookList[i].endDate}")</p>
                                    <a href="@Url.Action("Delete", "Booking", new { bookingid = Model.bookList[i].Id })">
                                        <a href="@Url.Action("cancelBooking", "Booking" ,new{id = Model.bookList[i].Id})">
                                            <button type="button" class="btn btn-outline-danger btn-sm">Remove</button>
                                        </a>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            @if (!flag)
            {
                <h4 class="text-center text-black">No Bookings Yet!</h4>
            }
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Cart Summary</h5>
                    <hr>
                    <p>Total Items: @Model.bookList.Count</p>
                    <p>Total Price: @($"${@pp}")</p>
                    @{
                        string priceString = pp.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    }
                    @{
                        HttpContextAccessor.HttpContext.Session.SetString("Price", pp.ToString());
                        HttpContextAccessor.HttpContext.Session.SetString("PaymentBookings", string.Join(",", Model.bookList.Select(b => b.Id)));
                    }
                    <a href="@Url.Action("Index", "Payment")">
                        <button class="btn btn-orange btn-lg w-100 mb-2">Checkout</button>
                    </a>
                    <a href="@Url.Action("Index", "Booking")">
                        <button class="btn btn-outline-secondary btn-lg w-100">Continue Shopping</button>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
