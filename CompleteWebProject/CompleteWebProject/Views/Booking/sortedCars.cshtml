@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using Project.Models.Domains
@model List<Car>
@{
    bool flag = false;
    var userId = HttpContextAccessor.HttpContext.Session.GetString("UserId");
}

<h5 class="text-black">Total Cars Found : <span class="text-warning">@Model.Count(car => car.isAvailable == 1)</span></h5>

@if (Model.Count > 0)
{
    @for (int i = 0; i < Model.Count; i++)
    {
        @if (Model[i].isAvailable == 1)
        {
            flag = true;
            <div class="card car-card">
                <div class="row g-0">
                    <div class="col-md-5 col-12">
                        <img src="@Model[i].imageUrl" class="card-img-top" alt="Car Image" width="100">
                    </div>
                    <div class="col-md-7">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge badge-new-car">For Rent</span>
                                </div>
                                <div class="price-tag">@($"$ {Model[i].pricePerDay}/Day")</div>
                            </div>
                            <h5 class="card-title mt-3">@($"{Model[i].make} {Model[i].model}")</h5>
                            <p class="text-muted"><i class="bi bi-geo-alt"></i> 71 - Wast San Park St, New York, NY 98517</p>
                            <a href="@Url.Action("Book","Booking",new{carid=Model[i].Id})">
                                <button type="submit" class="btn btn-outline-warning btn-sm">Book Now</button>
                            </a>
                            <div class="mt-3">
                                <small>Model: @Model[i].year  •  Category: @Model[i].category  •  Fuel: @Model[i].fuelType</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
}
@if (!flag)
{
    <h4 class="text-center text-black">No Cars Available Right Now!</h4>
}