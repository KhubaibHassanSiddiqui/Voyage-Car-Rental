@using Project.Models.Domains
@model AspNetUsers
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<head>
    <title>Profile</title>
</head>

<div class="container-fluid my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header text-center">
                    <h4>Edit Profile</h4>
                </div>
                <div class="card-body">
                    <form id="editProfileForm" enctype="multipart/form-data">
                        <input type="hidden" name="gender" value="@Model?.gender">
                        <input type="hidden" name="isAdmin" value="@Model?.isAdmin">
                        <div class="mb-3">
                            <label for="firstName" class="form-label">First Name</label>
                            <input type="text" class="form-control" id="firstName" name="firstName" required value="@Model?.firstName">
                        </div>
                        <div class="mb-3">
                            <label for="lastName" class="form-label">Last Name</label>
                            <input type="text" class="form-control" id="lastName" name="lastName" required value="@Model?.lastName">
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" required value="@Model?.Email">
                        </div>
                        <div class="mb-3">
                            <label for="phone" class="form-label">Phone Number</label>
                            <input type="tel" class="form-control" id="phone" name="phone" value="@Model?.PhoneNumber">
                        </div>
                        <div class="mb-3">
                            <label for="address" class="form-label">Address</label>
                            <input type="text" class="form-control" id="address" name="address" value="@Model?.address">
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" class="form-control" id="password" name="password">
                        </div>
                        <div class="mb-3">
                            <label for="imageUrl" class="form-label">Profile Picture</label>
                            <input type="file" class="form-control" id="imageUrl" name="imageUrl">
                        </div>
                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Profile", "Admin")" class="btn btn-secondary">Cancel</a>
                            <button type="button" class="btn btn-primary" onclick="submitProfileForm();">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function submitProfileForm() {
        console.log("Submit button clicked");

        var form = document.getElementById("editProfileForm");
        var formData = new FormData(form);

        console.log("FormData created");

        $.ajax({
            url: '@Url.Action("editProfile", "Admin")',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (data) {
                console.log("AJAX call successful");
                window.location.href = '@Url.Action("Profile", "Admin")';
            },
            error: function (xhr, status, error) {
                console.error('Error occurred:', xhr.responseText);
            }
        });
    }
</script>
