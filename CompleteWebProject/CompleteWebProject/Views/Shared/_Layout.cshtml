@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.5.1/nouislider.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.5.1/nouislider.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body>
    <div class="container-fluid p-0 m-0">
        <div class="navbar-upper d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="fas fa-envelope me-2 ms-2" style="color:#ff6600"></i>
                <a href="mailto:khubaibhassan11@gmail.com">support@voyage.com</a>
                <i class="fas fa-clock ms-3 me-2" style="color:#ff6600"></i>
                <span>10:00 a.m. - 5:00 p.m.</span>
            </div>

            <div class="social-icons d-flex">
                <a href="https://www.facebook.com/KhubaibHassanSiddiqui?mibextid=ZbWKwL" target="_blank" class="me-2">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="https://www.instagram.com/khubaibhassan_?igsh=MWR2d2tycHF0c2V0dQ==" target="_blank" class="me-2">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="https://x.com/IamK_H_S" target="_blank" class="me-2">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="https://www.linkedin.com/in/khubaib-hassan-8b63b0139?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=android_app" target="_blank">
                    <i class="fab fa-linkedin-in"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="container-fluid p-2 nav-bg-color">
        <div class="row align-items-center">
            <div class="col-auto">
                @{
                    var userId = HttpContextAccessor.HttpContext.Session.GetInt32("UserId") as int?;
                    var username=ViewBag.Username;
                }
                <a href="@Url.Action("Index", "Home", new { id = userId })">
                    <img src="/img/logo.png" width="120" height="80" alt="Logo">
                </a>
                <a href="@Url.Action("Index", "Home", new { id = userId })">
                    <h1 class="heading1 d-inline">VOYAGE</h1>
                </a>
            </div>
            <div class="col">
                <form class="d-flex align-items-center" method="get" asp-action="search" asp-controller="Home" id="searchForm">
                    <input class="form-control search-input me-2" type="search" placeholder="Search" aria-label="Search" id="searchQuery" name="searchQuery">
                    <button class="btn search-button nav-margin" type="submit" id="searchButton">
                        <i class="fas fa-search"></i>
                    </button>
                </form>
            </div>
            <div class="col-auto nav-margin">
                <nav class="navbar navbar-expand-lg bg-transparent">
                    <div class="container-fluid p-1">
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                                data-bs-target="#navbarScroll" aria-controls="navbarScroll" aria-expanded="false"
                                aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon" style="background-image: url('data:image/svg+xml;charset=utf8,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 30 30\'%3E%3Cpath stroke=\'%23ff6600\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-miterlimit=\'10\' d=\'M4 7h22M4 15h22M4 23h22\'/%3E%3C/svg%3E');"></span>
                        </button>
                        <div class="collapse navbar-collapse nav-icons" id="navbarScroll">
                            <ul class="navbar-nav me-auto my-2 my-lg-0">
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "Home")">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "Booking")">Catalog</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "Review")">Reviews</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("About", "Home")">About</a>
                                </li>
                            </ul>
                            <div class="col-auto ms-2 d-flex">
                                <div class="dropdown d-inline-block">
                                    @{
                                        if (@userId != null)
                                        {
                                            <button class="btn dropdown-toggle" type="button" id="profileDropdown"
                                                    data-bs-toggle="dropdown" aria-expanded="false">
                                                <img src="@ViewBag.url" alt="Profile" width="50px" height="auto" class="rounded-circle">
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end text-center" style="width:auto" aria-labelledby="profileDropdown">
                                                <li><a class="dropdown-item" href="@Url.Action("Index", "User")">Profile</a></li>
                                                <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")">Logout</a></li>
                                            </ul>
                                        }

                                        else
                                        {
                                            <a asp-area="Identity" asp-page="/Account/Login">
                                                <button class="btn btn-outline-primary signin-btn">
                                                    <i class="bi bi-person"></i>Sign in
                                                </button>
                                            </a>
                                        }
                                    }

                                </div>
                                <div>
                                    @if (userId != null)
                                    {
                                        if (ViewBag.bookingCount > 0)
                                        {
                                            <a href="@Url.Action("Cart", "Booking")">
                                                <button class="btn ms-2 search-button mt-3 position-relative" type="button">
                                                    <i class="fas fa-shopping-cart"></i>
                                                    <span class="badge rounded-pill bg-warning position-absolute cart-badge text-black">@ViewBag.bookingCount</span>
                                                </button>
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="dropdown">
                                                <button class="btn ms-2 search-button mt-3 position-relative dropdown-toggle" type="button" id="cartDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="fas fa-shopping-cart"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end text-center" aria-labelledby="cartDropdown">
                                                    <li><p class="dropdown-item">No Bookings yet!</p></li>
                                                </ul>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="dropdown">
                                            <button class="btn ms-2 mt-1 search-button position-relative dropdown-toggle" type="button" id="cartDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-shopping-cart"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end text-center" aria-labelledby="cartDropdown">
                                                <li><p class="dropdown-item">No Bookings yet!</p></li>
                                            </ul>
                                        </div>
                                    }
                                </div>

                            </div>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </div>
    
        @RenderBody()

    <div class="container-fluid p-2 pb-3 footer">
        <div class="row pt-5">
            <div class="col-12 footer-logo">
                <img src="/img/logo.png" alt="Logo" width="120" height="80">
                <span class="heading-2 text-white display-6 ms-md-3 ms-2 me-3">VOYAGE RENTALS</span>
            </div>
        </div>
        <div class="row footer-desc justify-content-around">
            <div class="col-md-4">
                <p class="text-white">
                    At Voyage, we believe in making every journey extraordinary. Drive with confidence, comfort, and style—because your adventure deserves the best.
                </p>
            </div>
            <div class="col-md-4">
                <div class="mb-3 footer-info">
                    <a href="https://maps.app.goo.gl/5E5fXu5LuAEwgnxm7" target="_blank">
                        <i class="bi bi-geo-alt display-9 mx-md-1 mx-sm-1 mx-1" style="color:#f1c40f"></i>
                        <span>
                            <strong>Main Office Address:</strong>
                            <br>
                            Punjab University College of Information Technology.
                        </span>
                    </a>
                </div>
                <div class="footer-info">
                    <i class="fas fa-clock display-9 mx-md-1 mx-sm-1 mx-1" style="color:#f1c40f"></i>
                    <span>10:00 a.m. - 5:00 p.m.</span>
                </div>
                <div class="py-2 footer-info">
                    <a href="mailto:khubaibhassan11@gmail.com" target="_blank">
                        <i class="bi bi-envelope display-9 mx-md-1 mx-sm-1 mx-1" style="color:#f1c40f"></i>
                        <span>support@voyage.com</span>
                    </a>
                </div>
                <div class="my-2 footer-info">
                    <a href="tel:+9290078601" target="_blank">
                        <i class="bi bi-telephone display-9 mx-md-1 mx-sm-1 mx-1" style="color:#f1c40f"></i>
                        <span>090078601</span>
                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="footer-faq">
                    <a href="@Url.Action("Index", "Booking")">
                        <i class="bi bi-box-arrow-up-right display-9 mx-md-1 mx-sm-1 mx-1" style="color:#f1c40f"></i>
                        <span>Cars Catalog</span>
                    </a>
                </div>
                <div class="my-2 footer-faq">
                    <a href="@Url.Action("Index", "Review")">
                        <i class="bi bi-box-arrow-up-right display-9 mx-md-1 mx-sm-1 mx-1" style="color:#f1c40f"></i>
                        <span>Reviews</span>
                    </a>
                </div>
                <div class="footer-faq">
                    <a href="@Url.Action("About", "Home")">
                        <i class="bi bi-box-arrow-up-right display-9 mx-md-1 mx-sm-1 mx-1" style="color:#f1c40f"></i>
                        <span>About US</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="navbar-upper d-flex justify-content-center align-items-center text-center">
        <p class="text-white">© 2024 Voyage Car Rental. All rights reserved.</p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            var isFirstSearch = sessionStorage.getItem('isFirstSearch') === null;

            $('#searchForm').on('submit', function (event) {
                event.preventDefault();

                var searchQuery = $('#searchQuery').val();

                if (isFirstSearch) {
                    console.log("First Search");
                    window.location.href = '@Url.Action("Search", "Home")' + "?searchQuery=" + encodeURIComponent(searchQuery);
                } else {
                    console.log("Subsequent search, making AJAX call");
                    $.ajax({
                        type: 'GET',
                        url: '@Url.Action("SearchResults", "Home")',
                        data: { searchQuery: searchQuery },
                        success: function (result) {
                            $('#searchResults').html(result);
                        },
                        error: function (xhr, status, error) {
                            console.error('Error occurred:', xhr.responseText);
                        }
                    });
                }

                sessionStorage.setItem('isFirstSearch', 'false');
            });
        });


    </script>

    
    <script type="text/javascript">
        function submitForm() {
            document.getElementById('sortForm').submit();
        }
    </script>


    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
