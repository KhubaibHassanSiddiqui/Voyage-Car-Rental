@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/styling.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
    <button class="toggler" onclick="toggleSidebar()">☰</button>

    <div class="d-flex">
        <nav id="sidebar" class="sidebar">
            <ul class="nav flex-column text-center nav-list">
                <li class="nav-item text-center mb-2">
                    <img src="/img/logo.png" width="50" height="50">
                    <h1 class="heading1 d-inline text-white">VOYAGE</h1>
                </li>
                <li class="nav-item text-center">
                    <a href="@Url.Action("Index", "User")" class="nav-link d-flex align-items-center justify-content-center"
                       aria-current="page">
                        <i class="bi bi-person pe-1" width="24" height="24" role="img" aria-label="Home"></i>
                        Profile
                    </a>
                </li>
                <li class="nav-item text-center">
                    <a href="@Url.Action("Index", "Home")" class="nav-link d-flex align-items-center justify-content-center"
                       aria-current="page">
                        <i class="bi bi-person pe-1" width="24" height="24" role="img" aria-label="Home"></i>
                        Home
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("manageBookings", "User")" class="nav-link d-flex align-items-center justify-content-center">
                        <i class="bi bi-box-seam pe-1" width="24" height="24" role="img" aria-label="Home"></i>
                        Bookings
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("manageReviews", "User")" class="nav-link d-flex align-items-center justify-content-center">
                        <i class="bi bi-people pe-1" width="24" height="24" role="img" aria-label="Home"></i>
                        Reviews
                    </a>
                </li>
            </ul>
            <div class="dropdown border-top mt-auto">
                <a href="#"
                   class="d-flex align-items-center justify-content-center p-3 link-dark text-decoration-none dropdown-toggle"
                   id="dropdownUser3" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="@ViewBag.url" alt="mdo" width="30" height="30" class="rounded-circle">
                </a>
                <ul class="dropdown-menu text-small shadow text-center text-white" aria-labelledby="dropdownUser3">
                    <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")">Sign out</a></li>
                </ul>
            </div>
        </nav>

        @RenderBody()

    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
</body>

</html>
